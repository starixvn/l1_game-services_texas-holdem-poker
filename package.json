{
  "name": "texas-holdem-poker",
  "version": "1.0.0",
  "description": "",
  "main": "./src/app.js",
  "scripts": {
    "test": "jest --testPathPattern=tests/unit-tests/",
    "test-:-integration-:-setup-test-data": "node --es-module-specifier-resolution=node ./tests/integration-tests/stubs/test-data-setup.js",
    "test-:-integration-:-start-service": "node --es-module-specifier-resolution=node ./tests/integration-tests/game-service-setup/game-service-app.js",
    "test-:-integration-:-start-test": "jest --testPathPattern=tests/integration-tests/  --detectOpenHandles --ci --reporters=default --reporters=jest-junit",
    "test-coverage": "jest --collect-coverage --testPathPattern=tests/unit-tests/",
    "dev": "nodemon --es-module-specifier-resolution=node --watch ./src ./src/app.js",
    "debug": "nodemon --es-module-specifier-resolution=node --watch ./ --inspect ./src/app.js",
    "prod": "node --max-old-space-size=8192 --es-module-specifier-resolution=node ./src/app.js",
    "reg": "npm set registry http://npm.lumigame.com",
    "stats": "nodemon --es-module-specifier-resolution=node --watch ./tests ./tests/stats/results.js"
  },
  "jestSonar": {
    "reportPath": "reports",
    "reportFile": "test-reporter.xml",
    "indent": 4
  },
  "author": "NEX5",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "d3-array": "^3.2.0",
    "lodash": "^4.17.19",
    "nodemon": "^2.0.4",
    "random-js": "^2.1.0",
    "sc-game-base": "3.0.7-beta.0"
  },
  "devDependencies": {
    "@babel/core": "^7.0.0",
    "@babel/preset-env": "^7.12.11",
    "@commitlint/cli": "^9.1.2",
    "@commitlint/config-conventional": "^9.1.2",
    "@semantic-release/changelog": "^5.0.1",
    "@semantic-release/commit-analyzer": "^8.0.1",
    "@semantic-release/git": "^9.0.0",
    "@semantic-release/gitlab": "^6.0.4",
    "@semantic-release/npm": "^7.0.5",
    "@semantic-release/release-notes-generator": "^9.0.1",
    "@types/jest": "^26.0.20",
    "babel-jest": "^26.6.3",
    "husky": "^4.2.5",
    "install": "^0.13.0",
    "jest": "^26.6.3",
    "jest-extended": "^0.11.5",
    "jest-junit": "^12.2.0",
    "jest-micro-auto-stub": "^1.0.6",
    "jest-sonar-reporter": "^2.0.0",
    "sc-game-service-integration-utils": "1.2.8-beta.0",
    "semantic-release": "^17.2.1"
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS",
      "pre-push": "yarn test"
    }
  },
  "jest": {
    "testResultsProcessor": "jest-junit"
  }
}
